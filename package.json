{
  "name": "nukesim",
  "private": true,
  "description": "Educational 3D nuclear-effects sandbox. Fictional cities, unclassified scaling laws. Not for targeting or emergency planning.",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukifer23/NukeSim.git"
  },
  "homepage": "https://github.com/lukifer23/NukeSim#readme",
  "keywords": [
    "nuclear-effects",
    "physics",
    "simulation",
    "education",
    "threejs",
    "react-three-fiber",
    "webgl",
    "vite",
    "typescript"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "NUKESIM_PERF=1 playwright test tests/e2e/performance.spec.ts --project=desktop --headed",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:assets": "node scripts/check-asset-budget.mjs",
    "capture": "node scripts/screenshot.mjs",
    "verify": "npm run lint && npm run test:coverage && npm run build && npm run check:bundle && npm run check:assets && npm run test:e2e",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
